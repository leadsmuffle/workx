# ==============================
# WorkX Backend - Environment Variables
# Copy this file to .env (local) or set these in your host's dashboard
# (Vercel/Render project settings). Values below are intentionally empty.
# ==============================

# Server
NODE_ENV=
PORT=
CLIENT_URL=

# MongoDB (MongoDB Atlas connection string in production)
MONGO_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_COOKIE_EXPIRES_DAYS=
JWT_REMEMBER_ME_EXPIRES_IN=

# Email (Gmail SMTP via Nodemailer — use a Google App Password, not your normal password)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not currently read by any backend code (reserved for a future frontend Stripe.js integration)
STRIPE_PUBLISHABLE_KEY=

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=

# EasyPaisa
EASYPAISA_STORE_ID=
# Not currently read by any backend code
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=

# Seat lock / booking hold time (minutes)
SEAT_HOLD_MINUTES=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX_REQUESTS=

# Vercel Blob (file uploads: profile pictures, workspace images, invoice PDFs)
BLOB_READ_WRITE_TOKEN=

# Secret used to authorize the daily Vercel Cron cleanup request
# (GET /api/bookings/cron/cleanup-expired). Vercel sends this automatically
# as "Authorization: Bearer <CRON_SECRET>" once this env var is set.
CRON_SECRET=
